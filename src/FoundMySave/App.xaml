<Application x:Class="FoundMySave.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palette sombre, contrastee pour rester lisible sur un ecran de portable. -->
        <SolidColorBrush x:Key="Bg"        Color="#12141A"/>
        <SolidColorBrush x:Key="Panel"     Color="#1B1E27"/>
        <SolidColorBrush x:Key="PanelEdge" Color="#2C3040"/>
        <SolidColorBrush x:Key="Text"      Color="#E8EAF0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA1B4"/>
        <SolidColorBrush x:Key="Accent"    Color="#C8953F"/>
        <SolidColorBrush x:Key="AccentDim" Color="#8A6529"/>
        <SolidColorBrush x:Key="Ok"        Color="#5FB07A"/>
        <SolidColorBrush x:Key="Warn"      Color="#D98A4A"/>

        <!--
            Drapeaux dessines plutot qu'images : nets a toute taille, et rien a
            embarquer. Un DrawingImage est gelable, donc partageable sans risque.
        -->
        <DrawingImage x:Key="FlagFrance">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#002395">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,20,40"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="20,0,20,40"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#ED2939">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="40,0,20,40"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="FlagUnitedKingdom">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#012169">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,60,40"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Croix de saint André, en blanc puis rouge -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="8"/></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="60,40"/>
                                <LineGeometry StartPoint="60,0" EndPoint="0,40"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#C8102E" Thickness="3.5"/></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="60,40"/>
                                <LineGeometry StartPoint="60,0" EndPoint="0,40"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Croix de saint Georges -->
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="24,0,12,40"/>
                                <RectangleGeometry Rect="0,14,60,12"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#C8102E">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="26.5,0,7,40"/>
                                <RectangleGeometry Rect="0,16.5,60,7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Bouton de langue : le drapeau de la langue inactive reste grise. -->
        <Style x:Key="FlagButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="4" Padding="5,4"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter x:Name="c" Opacity="0.45"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="c" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="c" Property="Opacity" Value="1"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="#262B3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton de l'action principale, pour qu'elle se distingue des autres. -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!--
            Sans ce style, la ligne selectionnee garde le fond systeme de Windows,
            clair, sous un texte clair : elle devient illisible. On redefinit donc
            les deux etats, survol et selection, avec un contraste suffisant.
        -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="4,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="row" Background="Transparent" BorderThickness="0,0,0,1"
                                BorderBrush="#232733" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#232838"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#3A2E14"/>
                                <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#F6E4C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#232733"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

    </Application.Resources>
</Application>
