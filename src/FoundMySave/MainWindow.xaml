<Window x:Class="FoundMySave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FoundMySave"
        Title="FoundMySave - RuneScape: Dragonwilds"
        Height="640" Width="920"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="{StaticResource Bg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre, logo et choix de la langue -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="Assets/logo.png" Width="52" Height="52"
                   VerticalAlignment="Center" Margin="0,0,14,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="FoundMySave" FontSize="24" FontWeight="Light"/>
                <TextBlock Text="{local:Translate App.Subtitle}"
                           Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="FrButton" Style="{StaticResource FlagButton}"
                              ToolTip="{local:Translate Lang.French}" Click="OnFrench">
                    <Image Source="{StaticResource FlagFrance}" Width="30" Height="20"/>
                </ToggleButton>
                <ToggleButton x:Name="EnButton" Style="{StaticResource FlagButton}"
                              ToolTip="{local:Translate Lang.English}" Click="OnEnglish" Margin="6,0,0,0">
                    <Image Source="{StaticResource FlagUnitedKingdom}" Width="30" Height="20"/>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Installations detectees -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="StatusTitle" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDetail" Foreground="{StaticResource TextMuted}"
                           FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Liste des mondes -->
        <Grid Grid.Row="2">
            <ListView x:Name="WorldList" SelectionChanged="OnSelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{local:Translate Col.World}" Width="215"
                                        DisplayMemberBinding="{Binding NameDisplay}"/>
                        <GridViewColumn Header="{local:Translate Col.LastSave}" Width="165"
                                        DisplayMemberBinding="{Binding SavedDisplay}"/>
                        <GridViewColumn Header="{local:Translate Col.Size}" Width="90"
                                        DisplayMemberBinding="{Binding SizeDisplay}"/>
                        <GridViewColumn Header="{local:Translate Col.Origin}" Width="165"
                                        DisplayMemberBinding="{Binding OriginDisplay}"/>
                        <GridViewColumn Header="{local:Translate Col.File}" Width="175"
                                        DisplayMemberBinding="{Binding SourceDisplay}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Message affiche quand la liste est vide -->
            <Border x:Name="EmptyPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                    BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470">
                    <TextBlock x:Name="EmptyTitle" FontSize="15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextMuted}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Option de sauvegarde de secours -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelEdge}"
                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
            <StackPanel>
                <CheckBox x:Name="AutoBackupCheck" Content="{local:Translate Backup.Label}"
                          Checked="OnAutoBackupToggled" Unchecked="OnAutoBackupToggled"/>
                <TextBlock x:Name="AutoBackupHint" Foreground="{StaticResource TextMuted}" FontSize="11"
                           Margin="24,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="RescanButton" Content="{local:Translate Btn.Rescan}" Click="OnRescan"/>

            <TextBlock Grid.Column="1" x:Name="FooterText" VerticalAlignment="Center" Margin="16,0"
                       Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="2" x:Name="ExportAllButton" Content="{local:Translate Btn.ExportAll}"
                    Click="OnExportAll" Margin="0,0,8,0" IsEnabled="False"/>

            <Button Grid.Column="3" x:Name="ExportServerButton" Content="{local:Translate Btn.ExportServer}"
                    Click="OnExportForServer" Margin="0,0,8,0" IsEnabled="False"/>

            <Button Grid.Column="4" x:Name="ExportButton" Content="{local:Translate Btn.Export}"
                    Style="{StaticResource PrimaryButton}" Click="OnExport" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
